NODE_ENV=development
PORT=3010
PUBLIC_BASE_URL=http://localhost:3010
WEB_DEV_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://chat_ai:chat_ai@localhost:5432/chat_ai
ADMIN_PASSWORD=
ADMIN_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_USAGE_GUARD_ENABLED=true
OPENAI_DAILY_TOKEN_BUDGET=6000000
OPENAI_BUDGET_GUARD_RESERVE_TOKENS=16000

CATALOG_BASE_URL=https://bakautprof.ru
CATALOG_MAX_PAGES=300
CATALOG_STALE_AFTER_HOURS=48
CATALOG_REQUEST_TIMEOUT_MS=35000
CATALOG_MAX_RESPONSE_BYTES=2097152
CATALOG_MAX_SITEMAP_BYTES=5242880
CATALOG_MAX_SITEMAP_FILES=100
CATALOG_MAX_SITEMAP_ENTRIES=100000
CATALOG_DEACTIVATION_MIN_DISCOVERY_RATIO=0.8
CATALOG_DEACTIVATION_MIN_DISCOVERY_FLOOR=100
CATALOG_IMPORT_ROOT=catalog-imports
CATALOG_MAX_CSV_BYTES=26214400
CATALOG_MAX_CSV_ROWS=50000

EMAIL_HTTP_URL=
EMAIL_HTTP_METHOD=POST
EMAIL_HTTP_AUTH_HEADER=
EMAIL_HTTP_TIMEOUT_MS=10000
EMAIL_FROM=site@bakautprof.ru
LEADS_TO_EMAIL=

# Optional Resend aliases supported for Railway compatibility.
# If RESEND_API_KEY is set, EMAIL_HTTP_URL defaults to https://api.resend.com/emails.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TIMEOUT_MS=10000
LEAD_EMAIL_TO=
LEAD_EMAIL=
