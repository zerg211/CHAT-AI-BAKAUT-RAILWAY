{
  "name": "bakaut-ai-sales-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run migrate && tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "lint:no-regex": "node scripts/no-regex-guard.mjs",
    "verify": "node tests/aiManagerReleaseGate.mjs",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "catalog:sync": "tsx src/scripts/syncCatalog.ts",
    "catalog:sync:sitemap": "tsx src/scripts/syncCatalogSitemap.ts",
    "catalog:inventory": "tsx src/scripts/inventoryCatalog.ts",
    "catalog:health": "tsx src/scripts/catalogHealth.ts",
    "catalog:import": "tsx src/scripts/importCatalogCsv.ts",
    "embeddings:backfill": "tsx src/scripts/backfillEmbeddings.ts",
    "embeddings:coverage": "tsx src/scripts/embeddingCoverage.ts",
    "feedback:export-evals": "tsx src/scripts/exportAssistantFeedbackEvals.ts",
    "test:acceptance:list": "node evals/acceptance/runner.cjs --list",
    "test:acceptance:offline": "node evals/acceptance/offline.cjs",
    "test:acceptance:mutations": "node evals/acceptance/mutations.cjs",
    "test:acceptance:host": "tsx evals/acceptance/app.ts",
    "test:acceptance:backend": "node evals/acceptance/backend.cjs",
    "test:acceptance:live": "node evals/acceptance/runner.cjs --run",
    "test:acceptance:release": "node evals/acceptance/runner.cjs --release"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.4.0",
    "openai": "^6.9.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.29.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "ws": "^8.21.0",
    "fast-uri": "^3.1.5",
    "brace-expansion": "^5.0.9"
  },
  "engines": {
    "node": ">=22"
  }
}
