{
  "name": "bakaut-ai-sales-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run migrate && tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "evals": "node evals/promptfoo/run-promptfoo.cjs eval -c promptfooconfig.yaml --no-table",
    "evals:summarize": "node evals/promptfoo/summarize-results.cjs",
    "lint:no-regex": "node scripts/no-regex-guard.mjs",
    "verify": "node tests/aiManagerReleaseGate.mjs",
    "test:eval:agentic": "vitest run tests/agentRuntimeContractsEval.test.ts tests/agenticCycle876.test.ts tests/agentTurnContract.test.ts tests/recommendationRanking.test.ts",
    "test:remediation:external-readiness": "node tests/remediationExternalReadiness.mjs",
    "test:remediation:railway-source": "node tests/remediationRailwaySourceReadiness.mjs",
    "test:remediation:docker-image": "node tests/remediationDockerImageProof.mjs",
    "test:remediation:completion-audit": "node tests/remediationCompletionAudit.mjs",
    "test:remediation:postdeploy": "node tests/remediationPostdeploy.mjs",
    "test:remediation:predeploy": "node tests/aiManagerReleaseGate.mjs",
    "test:live:production": "node tests/liveAgentCycle.production.mjs",
    "prepare:live:production:scenario": "node tests/prepareProductionLiveDialogueScenario.mjs",
    "test:live:production:diverse": "node tests/liveAgentCycle.diverse.production.mjs",
    "test:live:production:custom-loads": "node tests/liveAgentCycle.custom-loads.production.mjs",
    "test:live:production:876": "node tests/liveAgentCycle.876.production.mjs",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "catalog:sync": "tsx src/scripts/syncCatalog.ts",
    "catalog:sync:sitemap": "tsx src/scripts/syncCatalogSitemap.ts",
    "catalog:inventory": "tsx src/scripts/inventoryCatalog.ts",
    "catalog:health": "tsx src/scripts/catalogHealth.ts",
    "catalog:import": "tsx src/scripts/importCatalogCsv.ts",
    "embeddings:backfill": "tsx src/scripts/backfillEmbeddings.ts",
    "embeddings:coverage": "tsx src/scripts/embeddingCoverage.ts",
    "feedback:export-evals": "tsx src/scripts/exportAssistantFeedbackEvals.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.4.0",
    "js-yaml": "^4.3.0",
    "openai": "^6.9.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.28.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.4",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "promptfoo": "^0.121.18",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22"
  }
}
